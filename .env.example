# Copy to .env and adjust. Never commit .env.

# Image used by compose files
IMAGE=docker.io/youruser/yourapp:latest

# Host port mapped to container port 8080
HOST_PORT=8080

# App
NODE_ENV=production
LOG_LEVEL=info
TZ=UTC

# QNAP (compose.qnap.yaml)
QNAP_DATA_DIR=/share/Container/yourapp/data
PUID=1000
PGID=100
